# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key

# Google Sheets (service account JSON path — see README for setup)
GOOGLE_SHEETS_CREDS_PATH=service_account.json
GOOGLE_SHEET_NAME=GDG Event RSVPs

# Twilio WhatsApp (https://console.twilio.com — Messaging > Try WhatsApp)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
